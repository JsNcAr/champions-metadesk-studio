# Dockerfile.windows - Cross-compiles Windows (.exe) on Linux via Wine
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
ENV WINEDEBUG=-all
ENV WINEPREFIX=/root/.wine
ENV WINEARCH=win64

# Install system dependencies, Wine, and Linux Python (for downloading wheels)
RUN dpkg --add-architecture i386 && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        wine wine64 wine32 \
        wget ca-certificates xvfb curl \
        gnupg unzip python3 python3-pip python3-venv && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# Initialize Wine prefix headlessly
RUN xvfb-run -a wineboot --init

# Download and unpack Windows Python 3.13 embeddable distribution
WORKDIR /tmp
RUN wget -q https://www.python.org/ftp/python/3.13.0/python-3.13.0-embed-amd64.zip && \
    mkdir -p /root/.wine/drive_c/Python313/Lib/site-packages && \
    unzip -q python-3.13.0-embed-amd64.zip -d /root/.wine/drive_c/Python313 && \
    rm python-3.13.0-embed-amd64.zip

# Configure python313._pth to include site-packages
RUN printf "python313.zip\n.\nLib/site-packages\nsite-packages\nimport site\n" > /root/.wine/drive_c/Python313/python313._pth

# Pre-download pip and basic wheels on Linux to bypass Wine network socket limitations
WORKDIR /tmp/wheels
RUN pip install --break-system-packages poetry poetry-plugin-export && \
    python3 -m pip download pip setuptools wheel \
        --dest /tmp/wheels \
        --only-binary=:all: \
        --platform win_amd64 \
        --python-version 3.13

# Install pip inside Windows Python (offline using pre-downloaded wheels)
WORKDIR /tmp
RUN wget -q https://bootstrap.pypa.io/get-pip.py && \
    xvfb-run -a wine C:\\Python313\\python.exe get-pip.py --no-index --find-links=/tmp/wheels && \
    rm get-pip.py

# Pre-download project dependencies and PyInstaller wheels on Linux
WORKDIR /tmp/wheels
COPY pyproject.toml poetry.lock ./
RUN poetry export -f requirements.txt --output requirements.txt --without-hashes && \
    sed -i 's/;.*//' requirements.txt && \
    python3 -m pip download -r requirements.txt \
        --dest /tmp/wheels \
        --platform win_amd64 \
        --python-version 3.13 \
        --only-binary=:all: && \
    python3 -m pip download pyinstaller setuptools wheel pefile pywin32-ctypes poetry-core altgraph pyinstaller-hooks-contrib packaging \
        --dest /tmp/wheels \
        --platform win_amd64 \
        --python-version 3.13 \
        --only-binary=:all:

# Copy project source code into container working directory
WORKDIR /app
COPY pyproject.toml poetry.lock pokemon_champions.spec ./
COPY src/ ./src/

# Install Windows packages offline inside Wine from pre-downloaded wheels
RUN xvfb-run -a wine C:\\Python313\\python.exe -m pip install --no-index --find-links=/tmp/wheels pyinstaller setuptools wheel altgraph pyinstaller-hooks-contrib pefile pywin32-ctypes -r /tmp/wheels/requirements.txt

# Build PyInstaller executable inside Wine using script directly
RUN xvfb-run -a wine C:\\Python313\\Scripts\\pyinstaller.exe pokemon_champions.spec --noconfirm --clean

# Default entrypoint copies the generated .exe to the mapped output directory
CMD ["cp", "-f", "dist/PokemonChampionsPlanningTool.exe", "/output/"]
